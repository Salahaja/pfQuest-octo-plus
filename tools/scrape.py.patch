+def cmd_probe(sess, targets):
+    """Save raw HTML for a handful of pages, so a parser can be written against
+    the real markup instead of a guess at it.
+
+    Reads nothing and parses nothing on purpose: the point is the bytes. Writes
+    to cache/html/probe_<kind><id>.html.
+
+    Default targets cover the three page shapes pfQuest data comes from:
+      quest 42079  Secrets of Moonwhisper  (start/end NPC, objectives)
+      npc   48608  Moonwhisper Moth        (spawn coordinates)
+      zone  5642   Moonwhisper Coast       (what the zone contains)
+    """
+    os.makedirs(DIR_HTML, exist_ok=True)
+    for kind, ident in targets:
+        url = "%s?%s=%s" % (BASE, kind, ident)
+        try:
+            r = sess.get(url)
+        except RuntimeError as e:
+            print("[probe] %s -> %s" % (url, e))
+            continue
+        path = os.path.join(DIR_HTML, "probe_%s%s.html" % (kind, ident))
+        with io.open(path, "w", encoding="utf-8") as f:
+            f.write(r.text)
+        print("[probe] %-36s -> %s (%d bytes)" % (url, os.path.basename(path), len(r.text)))
+    print("[probe] done -- the .html files are in %s" % DIR_HTML)
+
+
+DEFAULT_PROBES = [("quest", "42079"), ("npc", "48608"), ("zone", "5642")]
+
+FETCH_LIST = os.path.join(WORKDIR, "fetch.txt")
+
+
+def cmd_fetchlist(sess, limit=None):
+    """Fetch every page named in fetch.txt that is not already cached.
+
+    Resumable, and that is the point: a few hundred requests will be
+    interrupted, and nothing here should make starting again cost what has
+    already been paid for. A page on disk is never fetched twice.
+
+    fetch.txt is written by pfQuest-octo-extra/tools/parse_octo.py, which also
+    decides what belongs in it -- this end does no parsing at all."""
+    if not os.path.exists(FETCH_LIST):
+        sys.exit("no fetch.txt -- run: python ../../pfQuest-octo-extra/tools/"
+                 "parse_octo.py plan")
+
+    targets = []
+    for line in io.open(FETCH_LIST, encoding="utf-8"):
+        line = line.strip()
+        if not line or "=" not in line:
+            continue
+        kind, ident = line.split("=", 1)
+        targets.append((kind, ident))
+
+    os.makedirs(DIR_HTML, exist_ok=True)
+    todo = [(k, i) for k, i in targets
+            if not os.path.exists(os.path.join(DIR_HTML, "probe_%s%s.html" % (k, i)))]
+    if limit:
+        todo = todo[:limit]
+
+    print("[fetchlist] %d listed, %d already cached, %d to fetch"
+          % (len(targets), len(targets) - len(todo), len(todo)))
+
+    fails = 0
+    for idx, (kind, ident) in enumerate(todo, 1):
+        url = "%s?%s=%s" % (BASE, kind, ident)
+        try:
+            r = sess.get(url)
+        except RuntimeError as e:
+            print("[fetchlist] %s -> %s" % (url, e))
+            fails += 1
+            if fails >= 5:
+                sys.exit("five failures in a row, stopping -- re-run to resume")
+            continue
+        fails = 0
+        path = os.path.join(DIR_HTML, "probe_%s%s.html" % (kind, ident))
+        with io.open(path, "w", encoding="utf-8") as f:
+            f.write(r.text)
+        if idx % 20 == 0 or idx == len(todo):
+            print("[fetchlist] %d/%d" % (idx, len(todo)))
+    print("[fetchlist] round done -- now re-run parse_octo.py plan")
+
